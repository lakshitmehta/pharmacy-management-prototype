generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  POSTED
  VOIDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  CREDIT
  CHEMIST
  OWN_USE
}

enum MovementType {
  PURCHASE
  SALE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  ADJUSTMENT
  OPENING
}

enum LedgerSide {
  DEBIT
  CREDIT
}

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  CONTRA
}

enum NotificationType {
  LOW_STOCK
  EXPIRY
  SYSTEM
  AUDIT
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

model Store {
  id             String             @id @default(cuid())
  name           String
  code           String             @unique
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  users          User[]
  settings       StoreSettings?
  medicines      Medicine[]
  batches        MedicineBatch[]
  suppliers      Supplier[]
  customers      Customer[]
  sales          SalesInvoice[]
  purchases      PurchaseInvoice[]
  purchaseOrders PurchaseOrder[]
  movements      InventoryMovement[]
  auditEvents    AuditEvent[]
  notifications  Notification[]
  sessions       Session[]
  deviceSessions DeviceSession[]
  bankAccounts   BankAccount[]
  cashRegisters  CashRegister[]
  customerLedger CustomerLedgerEntry[]
  supplierLedger SupplierLedgerEntry[]
  receipts       CustomerReceipt[]
  supplierPayments SupplierPayment[]
  cashEntries    CashEntry[]
  vouchers       Voucher[]
}

model User {
  id             String          @id @default(cuid())
  storeId        String
  username       String
  passwordHash   String
  displayName    String
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sessions       Session[]
  deviceSessions DeviceSession[]
  auditEvents    AuditEvent[]
  notifications  Notification[]
  roles          UserRole[]
  @@unique([storeId, username])
  @@index([storeId, status])
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  permissions Json
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model Session {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model DeviceSession {
  id         String    @id @default(cuid())
  storeId    String
  userId     String
  signature  String
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, signature])
  @@index([userId, revokedAt])
}

model StoreSettings {
  id              String   @id @default(cuid())
  storeId         String   @unique
  gstin           String?
  drugLicense     String?
  phone           String?
  address         String?
  invoicePrefix   String   @default("INV")
  nextInvoiceNo   Int      @default(1)
  discountDisplay String   @default("AMOUNT")
  footerNotice    String?
  terms           String?
  gstScheme       String   @default("REGULAR_MONTHLY")
  eInvoiceEnabled Boolean  @default(false)
  ewayBillEnabled Boolean  @default(false)
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Medicine {
  id            String          @id @default(cuid())
  storeId       String
  name          String
  genericName   String?
  manufacturer  String?
  barcode       String?
  hsn           String?
  gstRate       Decimal         @default(0) @db.Decimal(5, 2)
  safetyLimit   Int             @default(15)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  aliases       MedicineAlias[]
  batches       MedicineBatch[]
  saleLines     SalesLine[]
  purchaseLines PurchaseLine[]
  purchaseOrderLines PurchaseOrderLine[]
  @@index([storeId, name])
  @@unique([storeId, barcode])
}

model MedicineAlias {
  id         String   @id @default(cuid())
  medicineId String
  value      String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  @@unique([medicineId, value])
}

model MedicineBatch {
  id           String              @id @default(cuid())
  storeId      String
  medicineId   String
  supplierId   String?
  batchNumber  String
  expiryDate   DateTime
  purchaseRate Decimal             @db.Decimal(12, 2)
  mrp          Decimal             @db.Decimal(12, 2)
  packSize     Int                 @default(1)
  freeQuantity Int                 @default(0)
  createdAt    DateTime            @default(now())
  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  medicine     Medicine            @relation(fields: [medicineId], references: [id])
  supplier     Supplier?           @relation(fields: [supplierId], references: [id])
  movements    InventoryMovement[]
  saleLines    SalesLine[]
  purchaseLines PurchaseLine[]
  @@unique([storeId, medicineId, batchNumber])
  @@index([storeId, expiryDate])
}

model InventoryMovement {
  id          String          @id @default(cuid())
  storeId     String
  batchId     String
  type        MovementType
  quantity    Int
  unitRate    Decimal         @db.Decimal(12, 2)
  referenceId String?
  reason      String?
  createdAt   DateTime        @default(now())
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  batch       MedicineBatch  @relation(fields: [batchId], references: [id])
  @@index([storeId, batchId, createdAt])
}

model Supplier {
  id          String                @id @default(cuid())
  storeId     String
  name        String
  code        String?
  contactName String?
  phone       String?
  email       String?
  gstin       String?
  address     String?
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  store       Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  batches     MedicineBatch[]
  purchases   PurchaseInvoice[]
  purchaseOrders PurchaseOrder[]
  ledger      SupplierLedgerEntry[]
  payments    SupplierPayment[]
  @@index([storeId, name])
}

model Customer {
  id          String                 @id @default(cuid())
  storeId     String
  name        String
  phone       String
  email       String?
  gstin       String?
  notes       String?
  createdAt   DateTime               @default(now())
  store       Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales       SalesInvoice[]
  ledger      CustomerLedgerEntry[]
  receipts    CustomerReceipt[]
  @@unique([storeId, phone])
  @@index([storeId, name])
}

model SalesInvoice {
  id            String                   @id @default(cuid())
  storeId       String
  customerId    String?
  invoiceNumber String
  status        InvoiceStatus            @default(POSTED)
  paymentMethod PaymentMethod
  subtotal      Decimal                  @db.Decimal(12, 2)
  discount      Decimal                  @db.Decimal(12, 2)
  tax           Decimal                  @db.Decimal(12, 2)
  total         Decimal                  @db.Decimal(12, 2)
  createdAt     DateTime                 @default(now())
  store         Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer      Customer?                @relation(fields: [customerId], references: [id])
  lines         SalesLine[]
  payments      SalePayment[]
  ledger        CustomerLedgerEntry[]
  receiptAllocations ReceiptAllocation[]
  @@unique([storeId, invoiceNumber])
  @@index([storeId, createdAt])
}

model SalesLine {
  id         String        @id @default(cuid())
  invoiceId  String
  medicineId String
  batchId    String
  quantity   Int
  unitRate   Decimal       @db.Decimal(12, 2)
  discount   Decimal       @db.Decimal(12, 2)
  tax        Decimal       @db.Decimal(12, 2)
  total      Decimal       @db.Decimal(12, 2)
  invoice    SalesInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  medicine   Medicine      @relation(fields: [medicineId], references: [id])
  batch      MedicineBatch @relation(fields: [batchId], references: [id])
}

model SalePayment {
  id        String        @id @default(cuid())
  invoiceId String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  invoice   SalesInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model CustomerLedgerEntry {
  id          String        @id @default(cuid())
  storeId     String
  customerId  String
  invoiceId   String?
  receiptId   String?
  side        LedgerSide
  amount      Decimal       @db.Decimal(12, 2)
  description String
  createdAt   DateTime      @default(now())
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer    Customer      @relation(fields: [customerId], references: [id])
  invoice     SalesInvoice? @relation(fields: [invoiceId], references: [id])
  receipt     CustomerReceipt? @relation(fields: [receiptId], references: [id])
  @@index([customerId, createdAt])
}

model PurchaseInvoice {
  id            String          @id @default(cuid())
  storeId       String
  supplierId    String
  invoiceNumber String
  invoiceDate   DateTime
  status        InvoiceStatus   @default(POSTED)
  subtotal      Decimal         @db.Decimal(12, 2)
  tax           Decimal         @db.Decimal(12, 2)
  total         Decimal         @db.Decimal(12, 2)
  reverseCharge Boolean         @default(false)
  createdAt     DateTime        @default(now())
  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier      Supplier        @relation(fields: [supplierId], references: [id])
  lines         PurchaseLine[]
  ledger        SupplierLedgerEntry[]
  paymentAllocations PaymentAllocation[]
  @@unique([storeId, invoiceNumber])
  @@index([storeId, invoiceDate])
}

model PurchaseOrder {
  id            String             @id @default(cuid())
  storeId       String
  supplierId    String
  orderNumber   String
  status        PurchaseOrderStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  lines         PurchaseOrderLine[]
  @@unique([storeId, orderNumber])
  @@index([storeId, status, createdAt])
}

model PurchaseOrderLine {
  id           String        @id @default(cuid())
  purchaseOrderId String
  medicineId   String
  quantity     Int
  freeQuantity Int           @default(0)
  unitRate     Decimal       @db.Decimal(12, 2)
  mrp          Decimal       @db.Decimal(12, 2)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicine     Medicine      @relation(fields: [medicineId], references: [id])
}

model PurchaseLine {
  id           String          @id @default(cuid())
  invoiceId    String
  medicineId   String
  batchId      String
  quantity     Int
  freeQuantity Int             @default(0)
  unitRate     Decimal         @db.Decimal(12, 2)
  mrp          Decimal         @db.Decimal(12, 2)
  tax          Decimal         @db.Decimal(12, 2)
  hsn          String?
  gstRate      Decimal         @default(0) @db.Decimal(5, 2)
  itcEligibility String        @default("ELIGIBLE")
  invoice      PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  medicine     Medicine        @relation(fields: [medicineId], references: [id])
  batch        MedicineBatch   @relation(fields: [batchId], references: [id])
}

model SupplierLedgerEntry {
  id          String           @id @default(cuid())
  storeId     String
  supplierId  String
  invoiceId   String?
  paymentId   String?
  side        LedgerSide
  amount      Decimal          @db.Decimal(12, 2)
  description String
  createdAt   DateTime         @default(now())
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier    Supplier         @relation(fields: [supplierId], references: [id])
  invoice     PurchaseInvoice? @relation(fields: [invoiceId], references: [id])
  payment     SupplierPayment? @relation(fields: [paymentId], references: [id])
  @@index([supplierId, createdAt])
}

model CustomerReceipt {
  id          String                 @id @default(cuid())
  storeId     String
  customerId  String
  amount      Decimal                @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  createdAt   DateTime               @default(now())
  store       Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer    Customer               @relation(fields: [customerId], references: [id])
  allocations ReceiptAllocation[]
  ledger      CustomerLedgerEntry[]
}

model ReceiptAllocation {
  id        String          @id @default(cuid())
  receiptId String
  invoiceId String
  amount    Decimal         @db.Decimal(12, 2)
  receipt   CustomerReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice   SalesInvoice    @relation(fields: [invoiceId], references: [id])
  @@unique([receiptId, invoiceId])
}

model SupplierPayment {
  id          String                @id @default(cuid())
  storeId     String
  supplierId  String
  amount      Decimal               @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  createdAt   DateTime              @default(now())
  store       Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier    Supplier              @relation(fields: [supplierId], references: [id])
  allocations PaymentAllocation[]
  ledger      SupplierLedgerEntry[]
}

model PaymentAllocation {
  id        String          @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal         @db.Decimal(12, 2)
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id])
  @@unique([paymentId, invoiceId])
}

model BankAccount {
  id      String      @id @default(cuid())
  storeId String
  name    String
  opening Decimal     @default(0) @db.Decimal(12, 2)
  store   Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  entries CashEntry[]
}

model CashRegister {
  id      String      @id @default(cuid())
  storeId String
  name    String
  opening Decimal     @default(0) @db.Decimal(12, 2)
  store   Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  entries CashEntry[]
}

model CashEntry {
  id          String        @id @default(cuid())
  storeId     String
  bankId      String?
  cashId      String?
  side        LedgerSide
  amount      Decimal       @db.Decimal(12, 2)
  description String
  referenceId String?
  createdAt   DateTime      @default(now())
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  bank        BankAccount?  @relation(fields: [bankId], references: [id])
  cash        CashRegister? @relation(fields: [cashId], references: [id])
  @@index([storeId, createdAt])
}

model Voucher {
  id        String        @id @default(cuid())
  storeId   String
  type      VoucherType
  number    Int
  date      DateTime
  narration String?
  createdAt DateTime      @default(now())
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lines     VoucherLine[]
  @@unique([storeId, type, number])
}

model VoucherLine {
  id        String   @id @default(cuid())
  voucherId String
  account   String
  debit     Decimal  @default(0) @db.Decimal(12, 2)
  credit    Decimal  @default(0) @db.Decimal(12, 2)
  voucher   Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id        String   @id @default(cuid())
  storeId   String
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
  @@index([storeId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  storeId   String
  userId    String?
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id])
  @@index([storeId, readAt, createdAt])
}